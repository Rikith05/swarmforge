# SwarmForge Configuration
# By default, SwarmForge runs 100% locally via the deterministic static-analysis + reasoning engine.
# Optionally add one or more provider API keys to route agent synthesis through live LLMs:

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

SWARMFORGE_DB_PATH=.swarmforge/swarmforge.db
SWARMFORGE_PORT=8765
